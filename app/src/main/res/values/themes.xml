<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Glacier" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/glacier_window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!--
      外部 API 窗口（ApiActivity）。
      必须**不透明**：录制层先 drawRect(surface) 再录内容，屏幕像素与录制像素才能一致；
      旧版 windowIsTranslucent=true + 92% 透明底色会让"可见像素 ≠ 录制像素"（Glass 审计 R4-P1）。
    -->
    <style name="Theme.Glacier.Api" parent="Theme.Glacier">
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowBackground">@color/glacier_window_background</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
